# Шаблон переменных окружения. Скопируйте в backend/.env и заполните своими значениями.
# Файл .env в git не попадает (см. .gitignore) — секреты хранятся только в нём.

# Секретный ключ Django: длинная случайная строка. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Режим отладки: True только на своём компьютере. На боевом сервере всегда False (или не задавайте).
DEBUG=True

# Допустимые адреса сервера через запятую.
# dev: можно не задавать (по умолчанию localhost и 127.0.0.1). prod: обязательно, например networkit.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: postgres://пользователь:пароль@хост:порт/база
# Регистр в имени базы важен. Если в пароле есть спецсимволы (@ : / #), закодируйте их (%40 %3A %2F %23).
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Адрес сайта (фронтенда): из него строятся ссылки в письмах. dev: http://localhost:5173
# На боевом сервере обязателен, например https://networkit.example.com
SITE_URL=http://localhost:5173

# ── Безопасность запросов ──
# Источники, с которых браузер может отправлять POST (проверка CSRF). По умолчанию — SITE_URL.
# dev: http://localhost:5173. Несколько значений — через запятую.
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Сколько прокси стоит перед Django. dev: 0 (по умолчанию). prod (Vercel + Railway): 2 (по умолчанию в prod).
# Нужен, чтобы лимиты запросов считались по настоящему IP клиента, а не по адресу Nginx.
NUM_PROXIES=0

# ── Почта ──
# Отправитель писем. dev: письма печатаются в консоль runserver, SMTP не нужен.
DEFAULT_FROM_EMAIL=NetworkIt <noreply@localhost>

# Только на боевом сервере (prod): SMTP провайдера писем. Без EMAIL_HOST prod не запустится,
# кроме демо с DEMO_LOG_VERIFY_LINKS=True (письма тогда печатаются в лог сервера).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Боевой сервер (Railway + Vercel): подробности и порядок действий — docs/DEPLOY.md ──
# На своём компьютере ничего из этого блока задавать не нужно.

# Какие настройки использовать. manage.py по умолчанию берёт dev, поэтому в консоли Railway
# переменная нужна: DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SETTINGS_MODULE=

# Адрес админки без домена, со слэшем в конце. По умолчанию admin/. На проде лучше сменить: например staff-8f3k/
# ADMIN_URL=admin/

# Включать HSTS (браузер запоминает «только HTTPS») на столько секунд. 0 = выключено (по умолчанию).
# Включайте (например 31536000) только когда убедились, что HTTPS работает везде.
# HSTS_SECONDS=0

# Демо без SMTP: ссылка подтверждения пишется в лог одной строкой «DEMO link: …».
# Только для демо с тестовыми данными. НА БОЕВОМ САЙТЕ ВКЛЮЧАТЬ НЕЛЬЗЯ (ссылка в логе = вход в чужой аккаунт).
# DEMO_LOG_VERIFY_LINKS=False

# Не читать файл backend/.env (для проверок боевых настроек: все значения только из окружения).
# SKIP_DOTENV=1

# На Railway ALLOWED_HOSTS должен содержать домен сервиса И healthcheck.railway.app:
#   ALLOWED_HOSTS=<сервис>.up.railway.app,healthcheck.railway.app
# SITE_URL — адрес сайта на Vercel (https, без слэша в конце). CSRF_TRUSTED_ORIGINS по умолчанию равен ему.
# NUM_PROXIES на проде по умолчанию 2 (Vercel + Railway).
