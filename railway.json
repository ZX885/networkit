{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python backend/manage.py collectstatic --noinput --settings=config.settings.prod"
  },
  "deploy": {
    "preDeployCommand": [
      "python backend/manage.py migrate --noinput --settings=config.settings.prod",
      "python backend/manage.py createcachetable --settings=config.settings.prod"
    ],
    "startCommand": "gunicorn config.wsgi:application --chdir backend --workers 2 --bind 0.0.0.0:$PORT --timeout 30",
    "healthcheckPath": "/api/health/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
